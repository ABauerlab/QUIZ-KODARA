# Copie para .env e preencha. O arquivo .env nao vai pro git.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Pixel da Kodara
VITE_META_PIXEL_ID=1200831484761221

# WhatsApp de atendimento, formato internacional sem simbolos
VITE_WHATSAPP_NUMBER=553132232356

# Chave PIX exibida na tela final
VITE_PIX_KEY=

# Opcional. URL da politica de privacidade da Kodara (ex: a que ja existe em
# vistakodara.com.br). Sem ela, o site ainda mostra o aviso de uso dos dados,
# so que sem link. O Meta pede que paginas de captacao de lead linkem uma
# politica de privacidade, entao vale preencher antes de rodar trafego.
VITE_PRIVACY_URL=

# URL publica do site, sem barra no final. Usada so no build (vite.config.ts)
# pra resolver og:url, og:image e canonical. Sem ela essas tags somem do HTML
# em vez de saírem vazias ou apontando pro lugar errado.
#
# ATUALIZAR NO DIA DA TROCA DE DOMINIO: enquanto for o dominio provisorio da
# Hostinger, usa ele; quando trocar pra quiz.vistakodara.com.br (ou outro
# definitivo), troca aqui e builda de novo. Ver DEPLOY.md, secao de troca de
# dominio, pra lista completa do que mais precisa mudar nesse dia.
VITE_SITE_URL=https://papayawhip-mole-185679.hostingersite.com
